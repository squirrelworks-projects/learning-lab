# Every request under /api goes to index.php – including requests for files that exist
# (routes.php, src/…, config.php), so nothing else in this folder can be read from the web.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !/api/index\.php$
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Without mod_rewrite the API can't work; refuse everything rather than serve the source.
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
